# Copy to .env.cloudflare (git-ignored) to deploy or run remote D1 migrations from this machine.
# CI sets the same variables from GitHub secrets (.github/workflows/deploy.yml).
CLOUDFLARE_ACCOUNT_ID=
DASHBOARD_D1_PREVIEW_ID=
DASHBOARD_D1_PRODUCTION_ID=
LEADERBOARD_D1_PREVIEW_ID=
LEADERBOARD_D1_PRODUCTION_ID=
# Only for scripts/cloudflare/access-apply.ts: who may open the preview hosts (comma-separated), and a token that can
# edit Access apps and policies and read identity providers.
ACCESS_ALLOWED_EMAILS=
CLOUDFLARE_API_TOKEN=
