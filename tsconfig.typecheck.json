{
  "extends": "./tsconfig.options.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@be-music/player-react": ["./packages/player-react/src/index.tsx"],
      "@be-music/*": ["./packages/*/src/index.ts"],
      "@be-music/parser/browser": ["./packages/parser/src/browser.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "scripts/**/*.ts", "vite.package.config.ts", "vitest.config.ts"],
  "exclude": ["scripts/**/*.test.ts"]
}
