// be-music course checklist fixture skin (LR2): the 7-key play screen. Eight lanes (scratch first), a judge line,
// the groove gauge and the course texts: the stage titles behind op 290 and a marker for the last stage (op 289).
#INFORMATION,0,BE-MUSIC E2E 7KEYS,be-music,
#ENDOFHEADER
#STARTINPUT,0
#LOADSTART,0
#LOADEND,0
#PLAYSTART,300
#FADEOUT,300
#CLOSE,300
#IMAGE,LR2files\Theme\E2E\parts.png
#FONT,16,1,0,sans-serif

// Background.
#SRC_IMAGE,0,0,0,0,64,64,1,1,0,0
#DST_IMAGE,0,0,0,0,640,480,0,255,255,255,255,0,0,0,0,0,0,0,0,0

// Notes: lane 0 is the scratch, lanes 1-7 the keys; each lane ends at the judge line (y 400).
#SRC_NOTE,0,0,0,128,64,8,1,1,0,0
#SRC_NOTE,1,0,0,192,64,8,1,1,0,0
#SRC_NOTE,2,0,0,64,64,8,1,1,0,0
#SRC_NOTE,3,0,0,192,64,8,1,1,0,0
#SRC_NOTE,4,0,0,64,64,8,1,1,0,0
#SRC_NOTE,5,0,0,192,64,8,1,1,0,0
#SRC_NOTE,6,0,0,64,64,8,1,1,0,0
#SRC_NOTE,7,0,0,192,64,8,1,1,0,0
#DST_NOTE,0,0,20,400,40,8,0,255,255,255,255,0,0,0,0,0,0,0,0,0
#DST_NOTE,1,0,62,400,30,8,0,255,255,255,255,0,0,0,0,0,0,0,0,0
#DST_NOTE,2,0,94,400,30,8,0,255,255,255,255,0,0,0,0,0,0,0,0,0
#DST_NOTE,3,0,126,400,30,8,0,255,255,255,255,0,0,0,0,0,0,0,0,0
#DST_NOTE,4,0,158,400,30,8,0,255,255,255,255,0,0,0,0,0,0,0,0,0
#DST_NOTE,5,0,190,400,30,8,0,255,255,255,255,0,0,0,0,0,0,0,0,0
#DST_NOTE,6,0,222,400,30,8,0,255,255,255,255,0,0,0,0,0,0,0,0,0
#DST_NOTE,7,0,254,400,30,8,0,255,255,255,255,0,0,0,0,0,0,0,0,0
#SRC_JUDGELINE,0,0,0,128,64,4,1,1,0,0
#DST_JUDGELINE,0,0,20,404,264,4,0,255,255,255,255,0,0,0,0,0,0,0,0,0

// The groove gauge: 50 cells of 4 pixels (lit / unlit, clear zone / survival zone).
#SRC_GROOVEGAUGE,0,0,0,128,64,16,4,1,0,0,4,0
#DST_GROOVEGAUGE,0,0,20,440,4,16,0,255,255,255,255,0,0,0,0,0,0,0,0,0

// A course stage (op 290): the course's first stages; the last stage (op 289) adds a marker.
#IF,290
#SRC_TEXT,0,0,150,0,0,0
#DST_TEXT,0,0,320,20,300,18,0,255,255,255,255,0,0,0,0,0,0,0,0,0
#SRC_TEXT,0,0,151,0,0,0
#DST_TEXT,0,0,320,44,300,18,0,255,255,255,255,0,0,0,0,0,0,0,0,0
