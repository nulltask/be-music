{
  "name": "@be-music/player",
  "version": "0.9.0",
  "description": "Core playback engine and shared gameplay helpers for be-music",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./signals": {
      "source": "./src/signals.ts",
      "types": "./dist/signals.d.ts",
      "default": "./dist/signals.js"
    },
    "./lanes": {
      "source": "./src/lanes.ts",
      "types": "./dist/lanes.d.ts",
      "default": "./dist/lanes.js"
    },
    "./display": {
      "source": "./src/display.ts",
      "types": "./dist/display.d.ts",
      "default": "./dist/display.js"
    },
    "./course": {
      "source": "./src/course/index.ts",
      "types": "./dist/course.d.ts",
      "default": "./dist/course.js"
    },
    "./replay": {
      "source": "./src/replay/index.ts",
      "types": "./dist/replay.d.ts",
      "default": "./dist/replay.js"
    },
    "./records": {
      "source": "./src/records/index.ts",
      "types": "./dist/records.d.ts",
      "default": "./dist/records.js"
    },
    "./ruleset": {
      "source": "./src/ruleset/vocabulary.ts",
      "types": "./dist/ruleset.d.ts",
      "default": "./dist/ruleset.js"
    },
    "./audio-sink": {
      "source": "./src/audio-sink.ts",
      "types": "./dist/audio-sink.d.ts",
      "default": "./dist/audio-sink.js"
    }
  },
  "scripts": {
    "build:bundle": "vp pack",
    "build": "vp pack",
    "clean": "rimraf dist",
    "bench": "node --conditions=source scripts/bench.ts"
  },
  "dependencies": {
    "@be-music/audio-renderer": "workspace:*",
    "@be-music/chart": "workspace:*",
    "@be-music/json": "workspace:*",
    "@be-music/parser": "workspace:*",
    "@be-music/utils": "workspace:*",
    "alien-signals": "^3.2.1",
    "node-web-audio-api": "^2.2.0"
  }
}
