{
  "name": "@be-music/player",
  "version": "0.5.0",
  "description": "Core playback engine and shared gameplay helpers for be-music",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./playable-notes": {
      "types": "./dist/playable-notes.d.ts",
      "source": "./src/playable-notes.ts",
      "default": "./dist/playable-notes.js"
    },
    "./audio-sink": {
      "types": "./dist/audio-sink.d.ts",
      "source": "./src/audio-sink.ts",
      "default": "./dist/audio-sink.js"
    },
    "./image-resize-algorithm": {
      "types": "./dist/image-resize-algorithm.d.ts",
      "source": "./src/image-resize-algorithm.ts",
      "default": "./dist/image-resize-algorithm.js"
    },
    "./judging": {
      "types": "./dist/judging.d.ts",
      "source": "./src/judging.ts",
      "default": "./dist/judging.js"
    },
    "./state-signals": {
      "types": "./dist/state-signals.d.ts",
      "source": "./src/state-signals.ts",
      "default": "./dist/state-signals.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "source": "./src/utils.ts",
      "default": "./dist/utils.js"
    },
    "./core/groove-gauge": {
      "types": "./dist/core/groove-gauge.d.ts",
      "source": "./src/core/groove-gauge.ts",
      "default": "./dist/core/groove-gauge.js"
    },
    "./core/bga-timeline": {
      "types": "./dist/core/bga-timeline.d.ts",
      "source": "./src/core/bga-timeline.ts",
      "default": "./dist/core/bga-timeline.js"
    },
    "./core/engine": {
      "types": "./dist/core/engine.d.ts",
      "source": "./src/core/engine.ts",
      "default": "./dist/core/engine.js"
    },
    "./core/high-speed-control": {
      "types": "./dist/core/high-speed-control.d.ts",
      "source": "./src/core/high-speed-control.ts",
      "default": "./dist/core/high-speed-control.js"
    },
    "./core/input-signal-bus": {
      "types": "./dist/core/input-signal-bus.d.ts",
      "source": "./src/core/input-signal-bus.ts",
      "default": "./dist/core/input-signal-bus.js"
    },
    "./core/judge-window": {
      "types": "./dist/core/judge-window.d.ts",
      "source": "./src/core/judge-window.ts",
      "default": "./dist/core/judge-window.js"
    },
    "./core/lane-layout": {
      "types": "./dist/core/lane-layout.d.ts",
      "source": "./src/core/lane-layout.ts",
      "default": "./dist/core/lane-layout.js"
    },
    "./core/scoring": {
      "types": "./dist/core/scoring.d.ts",
      "source": "./src/core/scoring.ts",
      "default": "./dist/core/scoring.js"
    },
    "./core/scroll-distance": {
      "types": "./dist/core/scroll-distance.d.ts",
      "source": "./src/core/scroll-distance.ts",
      "default": "./dist/core/scroll-distance.js"
    },
    "./core/timeline": {
      "types": "./dist/core/timeline.d.ts",
      "source": "./src/core/timeline.ts",
      "default": "./dist/core/timeline.js"
    },
    "./core/ui-options": {
      "types": "./dist/core/ui-options.d.ts",
      "source": "./src/core/ui-options.ts",
      "default": "./dist/core/ui-options.js"
    },
    "./core/ui-signal-bus": {
      "types": "./dist/core/ui-signal-bus.d.ts",
      "source": "./src/core/ui-signal-bus.ts",
      "default": "./dist/core/ui-signal-bus.js"
    }
  },
  "scripts": {
    "build:bundle": "tsdown",
    "build": "tsdown",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "bench": "tsx --tsconfig ../../tsconfig.typecheck.json scripts/bench.ts"
  },
  "dependencies": {
    "@be-music/audio-renderer": "workspace:*",
    "@be-music/chart": "workspace:*",
    "@be-music/json": "workspace:*",
    "@be-music/parser": "workspace:*",
    "@be-music/utils": "workspace:*",
    "alien-signals": "^3.2.1",
    "node-web-audio-api": "^2.1.0"
  }
}
