{
  "name": "@be-music/player",
  "version": "0.1.0",
  "description": "CLI BMS player with TUI, autoplay, and keyboard input",
  "license": "MIT",
  "bin": {
    "bms-player": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./playable-notes": {
      "types": "./dist/playable-notes.d.ts",
      "source": "./src/playable-notes.ts",
      "default": "./dist/playable-notes.js"
    },
    "./core/groove-gauge": {
      "types": "./dist/core/groove-gauge.d.ts",
      "source": "./src/core/groove-gauge.ts",
      "default": "./dist/core/groove-gauge.js"
    },
    "./core/judge-window": {
      "types": "./dist/core/judge-window.d.ts",
      "source": "./src/core/judge-window.ts",
      "default": "./dist/core/judge-window.js"
    },
    "./core/scoring": {
      "types": "./dist/core/scoring.d.ts",
      "source": "./src/core/scoring.ts",
      "default": "./dist/core/scoring.js"
    },
    "./core/scroll-distance": {
      "types": "./dist/core/scroll-distance.d.ts",
      "source": "./src/core/scroll-distance.ts",
      "default": "./dist/core/scroll-distance.js"
    },
    "./core/timeline": {
      "types": "./dist/core/timeline.d.ts",
      "source": "./src/core/timeline.ts",
      "default": "./dist/core/timeline.js"
    }
  },
  "scripts": {
    "build:bundle": "tsdown",
    "build": "tsdown",
    "build:sea": "tsx ../../scripts/build-sea.ts --package player",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "dev": "tsx --tsconfig ../../tsconfig.typecheck.json src/cli.ts",
    "diag:keyboard": "tsx --tsconfig ../../tsconfig.typecheck.json src/keyboard-diagnostic.ts",
    "diag:gameplay-input": "tsx --tsconfig ../../tsconfig.typecheck.json src/gameplay-input-diagnostic.ts",
    "typecheck": "tsgo -p tsconfig.typecheck.json --pretty",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "bench": "tsx --tsconfig ../../tsconfig.typecheck.json scripts/bench.ts"
  },
  "dependencies": {
    "@be-music/audio-renderer": "workspace:*",
    "@be-music/chart": "workspace:*",
    "@be-music/json": "workspace:*",
    "@be-music/parser": "workspace:*",
    "@be-music/utils": "workspace:*",
    "@uwx/libav.js-fat": "6.0.0-nightly.29.f420ff.ffmpeg.6.1.1",
    "alien-signals": "^3.1.2",
    "fast-bmp": "^4.0.1",
    "fast-png": "^8.0.0",
    "jpeg-js": "^0.4.4",
    "node-web-audio-api": "^1.0.9"
  }
}
