{
  "name": "@be-music/app-play",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 0.0.0.0",
    "build": "vp build",
    "build:cf": "vp build && printf 'ffmpeg-core/\\n.DS_Store\\n' > dist/.assetsignore",
    "cf:r2:create": "wrangler r2 bucket create play && wrangler r2 bucket create play-preview",
    "cf:r2:push": "pnpm run build:cf && node scripts/sync-ffmpeg-core.mjs --force",
    "cf:r2:push:preview": "pnpm run build:cf && node scripts/sync-ffmpeg-core.mjs --force --preview",
    "clean": "rimraf dist node_modules/.vite"
  },
  "dependencies": {
    "@be-music/chart-model": "workspace:*",
    "@be-music/chart-parser": "workspace:*",
    "@be-music/chart-source": "workspace:*",
    "@be-music/player-browser": "workspace:*",
    "@be-music/player-engine": "workspace:*",
    "@be-music/player-scene-model": "workspace:*",
    "@be-music/player-skin-sdk": "workspace:*",
    "@be-music/service-web-theme": "workspace:*",
    "@be-music/skin-beatoraja": "workspace:*",
    "@be-music/skin-lr2": "workspace:*",
    "@better-auth/passkey": "^1.7.10",
    "better-auth": "^1.7.10",
    "fflate": "^0.8.3",
    "lil-gui": "^0.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.151.0"
  }
}
