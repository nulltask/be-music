{
  "name": "@be-music/chart-parser",
  "version": "0.8.0",
  "description": "Parsers for BMS, bmson, and Be-Music JSON chart sources",
  "license": "MIT",
  "bin": {
    "bms-parse": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "source": "./src/core/index.ts",
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    }
  },
  "scripts": {
    "build:bundle": "vp pack",
    "build": "vp pack",
    "clean": "rimraf dist",
    "dev": "node --conditions=source src/cli.ts",
    "bench": "node --conditions=source scripts/bench.ts"
  },
  "dependencies": {
    "@be-music/chart-model": "workspace:*",
    "@be-music/chart-source": "workspace:*",
    "@be-music/shared-utils": "workspace:*",
    "fflate": "^0.8.3"
  }
}
