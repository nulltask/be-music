{
  "name": "@be-music/leaderboard-api",
  "version": "0.0.0",
  "private": true,
  "description": "Leaderboard API for be-music on Cloudflare Workers",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "deploy": "cf deploy",
    "deploy:preview": "cf deploy --mode preview",
    "secrets:preview": "node scripts/put-secrets.ts preview",
    "secrets:production": "node scripts/put-secrets.ts production",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "cf d1 migrations apply d3791c87-75f0-4d6b-8fd9-9013f0492006 --local --persist-to .wrangler/state --dir migrations",
    "db:migrate:preview": "cf d1 migrations apply f4f59881-e902-450c-892b-d764c481eb46 --dir migrations",
    "db:migrate:production": "cf d1 migrations apply d3791c87-75f0-4d6b-8fd9-9013f0492006 --dir migrations",
    "clean": "rimraf .wrangler .cloudflare",
    "build:css": "node scripts/build-css.ts",
    "build:icons": "node scripts/build-icons.ts",
    "build:client": "node scripts/build-client.ts"
  },
  "dependencies": {
    "@be-music/chart": "workspace:*",
    "@be-music/player": "workspace:*",
    "@better-auth/passkey": "^1.7.7",
    "@hono/standard-validator": "^0.4.0",
    "@scalar/hono-api-reference": "^0.12.12",
    "@valibot/to-json-schema": "^1.8.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "hono-openapi": "^1.3.5",
    "lucide-static": "1.49.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@be-music/parser": "workspace:*",
    "@cloudflare/workers-types": "^5.20261013.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/cli": "^4.3.3",
    "basecoat-css": "^1.0.2",
    "cf": "1.0.0-beta.14",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.149.0"
  }
}
