{
  "name": "@be-music/leaderboard-api",
  "version": "0.0.0",
  "private": true,
  "description": "Leaderboard API for be-music on Cloudflare Workers",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "node --experimental-strip-types scripts/generate.ts",
    "generate": "node scripts/generate.ts",
    "dev": "node scripts/generate.ts && pnpm run build:worker && cf dev",
    "deploy": "node scripts/generate.ts && pnpm run build:worker && cf deploy",
    "deploy:preview": "node scripts/generate.ts && pnpm run build:worker && cf deploy --mode preview",
    "secrets:preview": "node scripts/put-secrets.ts preview",
    "secrets:production": "node scripts/put-secrets.ts production",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "cf d1 migrations apply 2cb01ebf-4a70-4582-bb38-4e2e925bff61 --local --persist-to .wrangler/state --dir migrations",
    "db:migrate:preview": "cf d1 migrations apply 046723a8-244b-42ca-ad49-01c1914333f1 --dir migrations",
    "db:migrate:production": "cf d1 migrations apply 2cb01ebf-4a70-4582-bb38-4e2e925bff61 --dir migrations",
    "clean": "rimraf .wrangler .cloudflare",
    "build:css": "node scripts/build-css.ts",
    "build:icons": "node scripts/build-icons.ts",
    "build:fonts": "node scripts/build-fonts.ts",
    "build:client": "node scripts/build-client.ts",
    "build:worker": "vp build --config vite.worker.config.ts"
  },
  "dependencies": {
    "@be-music/chart": "workspace:*",
    "@be-music/player": "workspace:*",
    "@better-auth/passkey": "^1.7.10",
    "@hono/standard-validator": "^0.4.0",
    "@scalar/hono-api-reference": "^0.12.12",
    "@valibot/to-json-schema": "^1.8.0",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "hono-openapi": "^1.3.5",
    "lucide-static": "1.57.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@be-music/parser": "workspace:*",
    "@cloudflare/workers-types": "^5.20261015.1",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/cli": "^4.3.3",
    "basecoat-css": "^1.0.2",
    "cf": "1.0.0-beta.17",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.151.0"
  }
}
