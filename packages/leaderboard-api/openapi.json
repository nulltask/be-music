{
  "openapi": "3.1.0",
  "info": {
    "title": "be-music Leaderboard API",
    "description": "Version 0 is the beta: it may still change incompatibly (docs/leaderboard.md section 8). Requests are authenticated with the Better Auth session cookie from `/api/auth/*`; reads are public.",
    "version": "0"
  },
  "servers": [
    {
      "url": "/api/v0"
    }
  ],
  "components": {},
  "paths": {
    "/me": {
      "get": {
        "operationId": "getMe",
        "tags": [
          "Account"
        ],
        "summary": "My account",
        "responses": {
          "200": {
            "description": "The signed-in account.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "handle": {
                      "type": "string"
                    },
                    "displayName": {
                      "type": "string"
                    },
                    "anonymous": {
                      "type": "boolean",
                      "description": "True until the account has a way back in (a passkey)."
                    },
                    "passkeys": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "handle",
                    "displayName",
                    "anonymous",
                    "passkeys"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "No session: sign in first (anonymously is enough).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "enum": [
                        "sign-in-required"
                      ],
                      "type": "string",
                      "description": "Error code."
                    },
                    "detail": {
                      "type": "string",
                      "description": "Human-readable detail, for some errors."
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "The account does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "enum": [
                        "not-found"
                      ],
                      "type": "string",
                      "description": "Error code."
                    },
                    "detail": {
                      "type": "string",
                      "description": "Human-readable detail, for some errors."
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/scores": {
      "post": {
        "operationId": "postScores",
        "tags": [
          "Scores"
        ],
        "summary": "Submit a play",
        "description": "Submits a play log with its fingerprint documents. The body is JSON, gzip-compressed (`Content-Encoding: gzip`). The server re-simulates the play under every ruleset and answers its figures and ranks. The same play submitted again by the same account answers 200 with the stored result.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "playlog": {
                    "description": "The play log (`be-music-playlog`, docs/playlog.md)."
                  },
                  "playDocument": {
                    "description": "Fingerprint document of the played chart (the rolled branches); it must hash to `chart.playFingerprint`."
                  },
                  "chartDocument": {
                    "description": "Fingerprint document of the whole chart (every branch). Required the first time the server sees the chart."
                  }
                },
                "required": [
                  "playlog",
                  "playDocument"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Already submitted by this account: the stored result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "scoreId": {
                      "type": "string"
                    },
                    "chartFingerprint": {
                      "type": "string",
                      "description": "Chart fingerprint (`bmfp0:…`), the ranking key."
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ruleset": {
                            "enum": [
                              "lr2",
                              "beatoraja",
                              "iidx"
                            ],
                            "type": "string",
                            "description": "Ruleset the figures are simulated under."
                          },
                          "rulesetRevision": {
                            "type": "string",
                            "description": "Revision of the ruleset the play was simulated under (`lr2/0`, ...)."
                          },
                          "exScore": {
                            "type": "integer"
                          },
                          "noteCount": {
                            "type": "integer"
                          },
                          "clearLamp": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Clear lamp: 0 NO PLAY, 1 FAILED, 2 ASSIST EASY, 3 EASY, 4 CLEAR, 5 HARD, 6 EX HARD, 7 FULL COMBO, 8 PERFECT, 9 MAX."
                          },
                          "missCount": {
                            "type": "integer",
                            "description": "BP: BADs plus POORs."
                          },
                          "rank": {
                            "type": "integer",
                            "description": "The player’s rank on the chart after this play."
                          },
                          "players": {
                            "type": "integer"
                          },
                          "improved": {
                            "type": "object",
                            "properties": {
                              "exScore": {
                                "type": "boolean"
                              },
                              "lamp": {
                                "type": "boolean"
                              },
                              "missCount": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "exScore",
                              "lamp",
                              "missCount"
                            ],
                            "description": "Which personal bests this play improved."
                          }
                        },
                        "required": [
                          "ruleset",
                          "rulesetRevision",
                          "exScore",
                          "noteCount",
                          "clearLamp",
                          "missCount",
                          "rank",
                          "players",
                          "improved"
                        ]
                      },
                      "description": "The play under every ruleset."
                    }
                  },
                  "required": [
                    "scoreId",
                    "chartFingerprint",
                    "results"
                  ]
                }
              }
            }
          },
          "201": {
            "description": "Accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "scoreId": {
                      "type": "string"
                    },
                    "chartFingerprint": {
                      "type": "string",
                      "description": "Chart fingerprint (`bmfp0:…`), the ranking key."
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ruleset": {
                            "enum": [
                              "lr2",
                              "beatoraja",
                              "iidx"
                            ],
                            "type": "string",
                            "description": "Ruleset the figures are simulated under."
                          },
                          "rulesetRevision": {
                            "type": "string",
                            "description": "Revision of the ruleset the play was simulated under (`lr2/0`, ...)."
                          },
                          "exScore": {
                            "type": "integer"
                          },
                          "noteCount": {
                            "type": "integer"
                          },
                          "clearLamp": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Clear lamp: 0 NO PLAY, 1 FAILED, 2 ASSIST EASY, 3 EASY, 4 CLEAR, 5 HARD, 6 EX HARD, 7 FULL COMBO, 8 PERFECT, 9 MAX."
                          },
                          "missCount": {
                            "type": "integer",
                            "description": "BP: BADs plus POORs."
                          },
                          "rank": {
                            "type": "integer",
                            "description": "The player’s rank on the chart after this play."
                          },
                          "players": {
                            "type": "integer"
                          },
                          "improved": {
                            "type": "object",
                            "properties": {
                              "exScore": {
                                "type": "boolean"
                              },
                              "lamp": {
                                "type": "boolean"
                              },
                              "missCount": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "exScore",
                              "lamp",
                              "missCount"
                            ],
                            "description": "Which personal bests this play improved."
                          }
                        },
                        "required": [
                          "ruleset",
                          "rulesetRevision",
                          "exScore",
                          "noteCount",
                          "clearLamp",
                          "missCount",
                          "rank",
                          "players",
                          "improved"
                        ]
                      },
                      "description": "The play under every ruleset."
                    }
                  },
                  "required": [
                    "scoreId",
                    "chartFingerprint",
                    "results"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "The body is not a submission.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "enum": [
                        "invalid-submission",
                        "empty-body",
                        "invalid-encoding",
                        "invalid-json"
                      ],
                      "type": "string",
                      "description": "Error code."
                    },
                    "detail": {
                      "type": "string",
                      "description": "Human-readable detail, for some errors."
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "No session: sign in first (anonymously is enough).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "enum": [
                        "sign-in-required"
                      ],
                      "type": "string",
                      "description": "Error code."
                    },
                    "detail": {
                      "type": "string",
                      "description": "Human-readable detail, for some errors."
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "`chart-document-required`: send `chartDocument` too. `play-already-submitted`: another account sent it.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "enum": [
                        "chart-document-required",
                        "play-already-submitted"
                      ],
                      "type": "string",
                      "description": "Error code."
                    },
                    "detail": {
                      "type": "string",
                      "description": "Human-readable detail, for some errors."
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "413": {
            "description": "The body is too large.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "enum": [
                        "body-too-large"
                      ],
                      "type": "string",
                      "description": "Error code."
                    },
                    "detail": {
                      "type": "string",
                      "description": "Human-readable detail, for some errors."
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "415": {
            "description": "Not gzip-compressed JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "enum": [
                        "expected-json",
                        "unsupported-encoding"
                      ],
                      "type": "string",
                      "description": "Error code."
                    },
                    "detail": {
                      "type": "string",
                      "description": "Human-readable detail, for some errors."
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "The play cannot be ranked: an auto or aborted play, a malformed play log, or a fingerprint document that does not hash to the play log’s fingerprint.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "enum": [
                        "invalid-playlog",
                        "auto-play",
                        "aborted",
                        "missing-fingerprint",
                        "play-document-not-a-document",
                        "play-document-fingerprint-mismatch",
                        "chart-document-not-a-document",
                        "chart-document-fingerprint-mismatch"
                      ],
                      "type": "string",
                      "description": "Error code."
                    },
                    "detail": {
                      "type": "string",
                      "description": "Human-readable detail, for some errors."
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Too many submissions; retry after `Retry-After` seconds.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "enum": [
                        "rate-limited"
                      ],
                      "type": "string",
                      "description": "Error code."
                    },
                    "detail": {
                      "type": "string",
                      "description": "Human-readable detail, for some errors."
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/scores/{id}": {
      "get": {
        "operationId": "getScoresById",
        "tags": [
          "Scores"
        ],
        "summary": "A play",
        "responses": {
          "200": {
            "description": "The play under every ruleset.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "chartFingerprint": {
                      "type": "string"
                    },
                    "playFingerprint": {
                      "type": "string",
                      "description": "Fingerprint of the branches this play rolled."
                    },
                    "player": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "handle": {
                              "type": "string"
                            },
                            "displayName": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "handle",
                            "displayName"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "playedRuleset": {
                      "enum": [
                        "lr2",
                        "beatoraja",
                        "iidx"
                      ],
                      "type": "string",
                      "description": "Ruleset the figures are simulated under."
                    },
                    "gauge": {
                      "type": "string"
                    },
                    "assisted": {
                      "type": "boolean"
                    },
                    "assistFlags": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "verification": {
                      "type": "string",
                      "description": "Highest verification layer passed (`L3`, `L4`, ...)."
                    },
                    "createdAt": {
                      "type": "integer",
                      "description": "When the play was accepted (epoch ms)."
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ruleset": {
                            "enum": [
                              "lr2",
                              "beatoraja",
                              "iidx"
                            ],
                            "type": "string",
                            "description": "Ruleset the figures are simulated under."
                          },
                          "rulesetRevision": {
                            "type": "string"
                          },
                          "exScore": {
                            "type": "integer"
                          },
                          "noteCount": {
                            "type": "integer"
                          },
                          "clearLamp": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Clear lamp: 0 NO PLAY, 1 FAILED, 2 ASSIST EASY, 3 EASY, 4 CLEAR, 5 HARD, 6 EX HARD, 7 FULL COMBO, 8 PERFECT, 9 MAX."
                          },
                          "missCount": {
                            "type": "integer"
                          },
                          "maxCombo": {
                            "type": "integer"
                          },
                          "gaugeType": {
                            "type": "string"
                          },
                          "gaugeFinal": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ],
                            "description": "Gauge at the end of the play, in percent."
                          },
                          "judges": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {
                              "type": "number"
                            },
                            "description": "Judgment counts."
                          }
                        },
                        "required": [
                          "ruleset",
                          "rulesetRevision",
                          "exScore",
                          "noteCount",
                          "clearLamp",
                          "missCount",
                          "maxCombo",
                          "gaugeType",
                          "gaugeFinal",
                          "judges"
                        ]
                      }
                    }
                  },
                  "required": [
                    "id",
                    "chartFingerprint",
                    "playFingerprint",
                    "player",
                    "playedRuleset",
                    "gauge",
                    "assisted",
                    "assistFlags",
                    "verification",
                    "createdAt",
                    "results"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "The score does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "enum": [
                        "not-found"
                      ],
                      "type": "string",
                      "description": "Error code."
                    },
                    "detail": {
                      "type": "string",
                      "description": "Human-readable detail, for some errors."
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ]
      }
    },
    "/scores/{id}/playlog": {
      "get": {
        "operationId": "getScoresByIdPlaylog",
        "tags": [
          "Scores"
        ],
        "summary": "A play’s play log",
        "description": "The stored play log, gzip-compressed. Only its player can read a private one.",
        "responses": {
          "200": {
            "description": "The play log (docs/playlog.md).",
            "content": {
              "application/json": {}
            }
          },
          "404": {
            "description": "The score or its play log does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "enum": [
                        "not-found"
                      ],
                      "type": "string",
                      "description": "Error code."
                    },
                    "detail": {
                      "type": "string",
                      "description": "Human-readable detail, for some errors."
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ]
      }
    },
    "/charts/{chartFingerprint}/leaderboard": {
      "get": {
        "operationId": "getChartsByChartFingerprintLeaderboard",
        "tags": [
          "Rankings"
        ],
        "summary": "A chart’s ranking",
        "description": "Players by best EX-Score under one ruleset; ties share a rank.",
        "responses": {
          "200": {
            "description": "A page of the ranking.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "entries": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "rank": {
                            "type": "integer",
                            "description": "Competition rank: ties share a rank."
                          },
                          "handle": {
                            "type": "string"
                          },
                          "displayName": {
                            "type": "string"
                          },
                          "anonymous": {
                            "type": "boolean"
                          },
                          "exScore": {
                            "type": "integer"
                          },
                          "exScoreId": {
                            "type": "string",
                            "description": "The score that set the best EX-Score."
                          },
                          "clearLamp": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Clear lamp: 0 NO PLAY, 1 FAILED, 2 ASSIST EASY, 3 EASY, 4 CLEAR, 5 HARD, 6 EX HARD, 7 FULL COMBO, 8 PERFECT, 9 MAX."
                          },
                          "missCount": {
                            "type": "integer"
                          },
                          "playCount": {
                            "type": "integer"
                          },
                          "playedHere": {
                            "type": "boolean",
                            "description": "Played under this ruleset at least once."
                          },
                          "achievedAt": {
                            "type": "integer",
                            "description": "When the best EX-Score was set (epoch ms)."
                          }
                        },
                        "required": [
                          "rank",
                          "handle",
                          "displayName",
                          "anonymous",
                          "exScore",
                          "exScoreId",
                          "clearLamp",
                          "missCount",
                          "playCount",
                          "playedHere",
                          "achievedAt"
                        ]
                      }
                    },
                    "players": {
                      "type": "integer",
                      "description": "Players matching the filters."
                    },
                    "offset": {
                      "type": "integer"
                    },
                    "limit": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "entries",
                    "players",
                    "offset",
                    "limit"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "error": {
                      "type": "array",
                      "items": {}
                    },
                    "data": {}
                  },
                  "required": [
                    "success",
                    "error",
                    "data"
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "ruleset",
            "schema": {
              "enum": [
                "lr2",
                "beatoraja",
                "iidx"
              ],
              "type": "string"
            },
            "required": true,
            "description": "Ruleset the figures are simulated under."
          },
          {
            "in": "query",
            "name": "assisted",
            "schema": {
              "enum": [
                "0",
                "1",
                "true",
                "false"
              ],
              "type": "string",
              "default": "0"
            },
            "description": "Rank assisted plays (their own ranking) instead of unassisted ones."
          },
          {
            "in": "query",
            "name": "anonymous",
            "schema": {
              "enum": [
                "0",
                "1",
                "true",
                "false"
              ],
              "type": "string",
              "default": "0"
            },
            "description": "Include anonymous players."
          },
          {
            "in": "query",
            "name": "played",
            "schema": {
              "enum": [
                "0",
                "1",
                "true",
                "false"
              ],
              "type": "string",
              "default": "0"
            },
            "description": "Only players who played the chart under this ruleset at least once."
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": "0"
            },
            "description": "Entries to skip."
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": "50"
            },
            "description": "Entries to return."
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "chartFingerprint",
            "required": true
          }
        ]
      }
    },
    "/charts/{chartFingerprint}/leaderboard/me": {
      "get": {
        "operationId": "getChartsByChartFingerprintLeaderboardMe",
        "tags": [
          "Rankings"
        ],
        "summary": "My rank on a chart",
        "description": "My best on the chart and my rank among every player, anonymous ones included.",
        "responses": {
          "200": {
            "description": "My rank.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "rank": {
                      "type": "integer"
                    },
                    "players": {
                      "type": "integer"
                    },
                    "exScore": {
                      "type": "integer"
                    },
                    "exScoreId": {
                      "type": "string"
                    },
                    "clearLamp": {
                      "type": "integer",
                      "description": "Best clear lamp (see the score results)."
                    },
                    "missCount": {
                      "type": "integer",
                      "description": "Fewest BP."
                    },
                    "playCount": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "rank",
                    "players",
                    "exScore",
                    "exScoreId",
                    "clearLamp",
                    "missCount",
                    "playCount"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "error": {
                      "type": "array",
                      "items": {}
                    },
                    "data": {}
                  },
                  "required": [
                    "success",
                    "error",
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "No session: sign in first (anonymously is enough).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "enum": [
                        "sign-in-required"
                      ],
                      "type": "string",
                      "description": "Error code."
                    },
                    "detail": {
                      "type": "string",
                      "description": "Human-readable detail, for some errors."
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "I have not played the chart under these filters.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "enum": [
                        "not-played"
                      ],
                      "type": "string",
                      "description": "Error code."
                    },
                    "detail": {
                      "type": "string",
                      "description": "Human-readable detail, for some errors."
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "ruleset",
            "schema": {
              "enum": [
                "lr2",
                "beatoraja",
                "iidx"
              ],
              "type": "string"
            },
            "required": true,
            "description": "Ruleset the figures are simulated under."
          },
          {
            "in": "query",
            "name": "assisted",
            "schema": {
              "enum": [
                "0",
                "1",
                "true",
                "false"
              ],
              "type": "string",
              "default": "0"
            },
            "description": "My rank among assisted plays instead of unassisted ones."
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "chartFingerprint",
            "required": true
          }
        ]
      }
    }
  }
}
