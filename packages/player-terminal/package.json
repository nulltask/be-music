{
  "name": "@be-music/player-terminal",
  "version": "0.6.0",
  "description": "Terminal player application and CLI for chart browsing, gameplay, and replay simulation",
  "license": "MIT",
  "bin": {
    "bms-player": "dist/cli.js",
    "bms-replay": "dist/replay-cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:bundle": "vp pack",
    "build": "vp pack",
    "build:sea": "node --conditions=source ../../scripts/build-sea.ts --package player",
    "clean": "rimraf dist",
    "dev": "node --conditions=source src/cli.ts",
    "replay": "node --conditions=source src/replay-cli.ts",
    "diag:keyboard": "node --conditions=source src/keyboard-diagnostic.ts",
    "diag:gameplay-input": "node --conditions=source src/gameplay-input-diagnostic.ts",
    "bench": "node --conditions=source scripts/bench.ts"
  },
  "dependencies": {
    "@be-music/chart-audio-renderer": "workspace:*",
    "@be-music/chart-model": "workspace:*",
    "@be-music/chart-parser": "workspace:*",
    "@be-music/chart-source": "workspace:*",
    "@be-music/player-engine": "workspace:*",
    "@be-music/shared-utils": "workspace:*",
    "@uwx/libav.js-fat": "6.0.0-nightly.29.f420ff.ffmpeg.6.1.1",
    "alien-signals": "^3.2.1",
    "fast-bmp": "^4.0.1",
    "fast-png": "^8.0.0",
    "jpeg-js": "^0.4.4"
  }
}
