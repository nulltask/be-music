{
  "name": "@be-music/app-accounts",
  "version": "0.1.0",
  "private": true,
  "description": "Account management and OIDC identity provider for be-music services",
  "type": "module",
  "scripts": {
    "deploy": "pnpm run build:client && cf deploy",
    "deploy:preview": "pnpm run build:client && cf deploy --mode preview",
    "build:client": "node scripts/build-client.ts",
    "db:migrate:preview": "cf d1 migrations apply <D1_DATABASE_ID> --dir migrations",
    "db:migrate:production": "cf d1 migrations apply <D1_DATABASE_ID> --dir migrations",
    "prepare": "node scripts/build-client.ts"
  },
  "dependencies": {
    "@be-music/service-auth-client": "workspace:*",
    "@be-music/service-web-theme": "workspace:*",
    "@better-auth/oauth-provider": "1.7.10",
    "@better-auth/passkey": "1.7.10",
    "better-auth": "1.7.10",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "cf": "1.0.0-beta.17",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "vite-plus": "catalog:",
    "wrangler": "^4.151.0"
  }
}
