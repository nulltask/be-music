{
  "name": "@be-music/player-react",
  "version": "0.1.0",
  "description": "React adapter for the be-music browser PixiJS core",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.tsx",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "bench": "tsx --tsconfig ../../tsconfig.typecheck.json scripts/bench.ts",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsgo -p tsconfig.typecheck.json --pretty",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check"
  },
  "dependencies": {
    "@be-music/player-web-core": "workspace:*",
    "react": "^19.2.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2"
  }
}
