{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker Workers Builds deploys (it overrides any other name with this one).
  "name": "be-music-player-demo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-02",
  // Account is resolved automatically: from the logged-in user locally (single account), and from the auto-generated
  // token in Workers Builds CI. If you ever belong to multiple accounts, set CLOUDFLARE_ACCOUNT_ID instead of hardcoding
  // it here.
  // Static Assets host the built SPA. `single-page-application` returns index.html for any unmatched path; the
  // `run_worker_first` entries force `/ffmpeg-core/*` and `/__url-load-proxy` through the Worker (see worker/index.ts)
  // so oversized ffmpeg assets can stream from R2 and URL auto-load archives can bypass browser CORS.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ffmpeg-core/*", "/__url-load-proxy", "/api/*", "/leaderboard/*"],
  },
  // Holds `ffmpeg-core.wasm` (~31 MB, over the 25 MiB Static Assets per-file limit) and its `ffmpeg-core.js` loader.
  // Create the bucket with `pnpm cf:r2:create` and upload the files with `pnpm cf:r2:push`.
  "r2_buckets": [
    {
      "binding": "FFMPEG_CORE",
      "bucket_name": "be-music-ffmpeg-core",
    },
  ],
  // The Leaderboard Worker (`packages/leaderboard-api`, deployed with `cf deploy`). It has no public URL; this Worker
  // forwards `/api/*` and `/leaderboard/*` to it so the player, the API and its session cookies share one origin.
  "services": [
    {
      "binding": "LEADERBOARD",
      "service": "be-music-leaderboard",
    },
  ],
  "observability": {
    "enabled": true,
  },
  // Branch previews. Workers Builds uploads every branch but `devel` as a preview version of this same Worker
  // (`wrangler versions upload --env preview`, one Preview URL per branch). A version carries its own bindings, so the
  // previews talk to the preview Leaderboard, and never to production data. Bindings are not inherited by an
  // environment, hence the repeats.
  "env": {
    "preview": {
      "name": "be-music-player-demo",
      "r2_buckets": [
        {
          "binding": "FFMPEG_CORE",
          "bucket_name": "be-music-ffmpeg-core",
        },
      ],
      "services": [
        {
          "binding": "LEADERBOARD",
          "service": "be-music-leaderboard-preview",
        },
      ],
    },
  },
}
