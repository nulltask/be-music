{
  "name": "@be-music/player-web-demo",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 0.0.0.0",
    "build": "vp build",
    "build:cf": "vp build && printf 'ffmpeg-core/\\n.DS_Store\\n' > dist/.assetsignore",
    "deploy:cf": "pnpm run build:cf && node scripts/sync-ffmpeg-core.mjs && wrangler deploy",
    "cf:r2:create": "wrangler r2 bucket create be-music-ffmpeg-core",
    "cf:r2:push": "pnpm run build:cf && node scripts/sync-ffmpeg-core.mjs --force",
    "clean": "rimraf dist tsconfig.tsbuildinfo node_modules/.vite"
  },
  "dependencies": {
    "@be-music/beatoraja-skin": "workspace:*",
    "@be-music/lr2-skin": "workspace:*",
    "@be-music/player-web": "workspace:*",
    "fflate": "^0.8.3",
    "lil-gui": "^0.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "ts-ebml": "^3.0.2",
    "vite": "catalog:",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plus": "catalog:",
    "wrangler": "^4.145.0"
  }
}
