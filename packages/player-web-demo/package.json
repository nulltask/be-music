{
  "name": "@be-music/player-web-demo",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 0.0.0.0",
    "build": "vp build",
    "build:cf": "vp build && printf 'ffmpeg-core/\\n.DS_Store\\n' > dist/.assetsignore",
    "deploy:cf": "pnpm run build:cf && node scripts/sync-ffmpeg-core.mjs && wrangler deploy",
    "cf:r2:create": "wrangler r2 bucket create be-music-ffmpeg-core",
    "cf:r2:push": "pnpm run build:cf && node scripts/sync-ffmpeg-core.mjs --force",
    "clean": "rimraf dist node_modules/.vite"
  },
  "dependencies": {
    "@be-music/beatoraja-skin": "workspace:*",
    "@be-music/chart": "workspace:*",
    "@be-music/json": "workspace:*",
    "@be-music/lr2-skin": "workspace:*",
    "@be-music/parser": "workspace:*",
    "@be-music/player": "workspace:*",
    "@be-music/player-web": "workspace:*",
    "@be-music/scene-model": "workspace:*",
    "@be-music/skin-sdk": "workspace:*",
    "@better-auth/passkey": "^1.7.7",
    "better-auth": "^1.7.10",
    "fflate": "^0.8.3",
    "lil-gui": "^0.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.151.0"
  }
}
