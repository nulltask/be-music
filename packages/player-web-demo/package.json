{
  "name": "@be-music/player-web-demo",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:cf": "vite build && printf 'ffmpeg-core/\\n.DS_Store\\n' > dist/.assetsignore",
    "deploy:cf": "pnpm run build:cf && node scripts/sync-ffmpeg-core.mjs && wrangler deploy",
    "cf:r2:create": "wrangler r2 bucket create be-music-ffmpeg-core",
    "cf:r2:push": "pnpm run build:cf && node scripts/sync-ffmpeg-core.mjs --force",
    "clean": "rimraf dist tsconfig.tsbuildinfo node_modules/.vite",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check"
  },
  "dependencies": {
    "@be-music/beatoraja-skin": "workspace:*",
    "@be-music/lr2-skin": "workspace:*",
    "@be-music/player-web": "workspace:*",
    "fflate": "^0.8.3",
    "lil-gui": "^0.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "ts-ebml": "^3.0.2",
    "vite": "^8.2.1",
    "vite-plugin-node-polyfills": "^0.28.0",
    "wrangler": "^4.124.0"
  }
}
