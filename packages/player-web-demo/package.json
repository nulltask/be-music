{
  "name": "@be-music/player-web-demo",
  "version": "0.2.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:cf": "vite build && printf 'ffmpeg-core/\\n.DS_Store\\n' > dist/.assetsignore",
    "deploy:cf": "pnpm run build:cf && wrangler deploy",
    "cf:r2:create": "wrangler r2 bucket create be-music-ffmpeg-core",
    "cf:r2:push": "pnpm run build:cf && wrangler r2 object put be-music-ffmpeg-core/ffmpeg-core.wasm --file=dist/ffmpeg-core/ffmpeg-core.wasm --content-type=application/wasm --remote && wrangler r2 object put be-music-ffmpeg-core/ffmpeg-core.js --file=dist/ffmpeg-core/ffmpeg-core.js --content-type=text/javascript --remote",
    "clean": "rimraf dist tsconfig.tsbuildinfo node_modules/.vite",
    "typecheck": "tsgo -p tsconfig.typecheck.json --pretty",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check"
  },
  "dependencies": {
    "@be-music/beatoraja-skin": "workspace:*",
    "@be-music/lr2-skin": "workspace:*",
    "@be-music/player-web": "workspace:*",
    "lil-gui": "^0.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260602.1",
    "ts-ebml": "^3.0.2",
    "vite": "^8.0.11",
    "vite-plugin-node-polyfills": "^0.28.0",
    "wrangler": "^4.96.0"
  }
}
