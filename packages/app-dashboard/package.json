{
  "name": "@be-music/app-dashboard",
  "version": "0.2.0",
  "private": true,
  "description": "Be-Music dashboard, account management and the OIDC identity provider for Be-Music services",
  "type": "module",
  "scripts": {
    "deploy": "pnpm run build:client && cf deploy",
    "deploy:preview": "pnpm run build:client && cf deploy --mode preview",
    "build:client": "node scripts/build-client.ts",
    "db:migrate:preview": "cf d1 migrations apply 5ff1bde7-a178-489f-9231-e78d232db866 --dir migrations",
    "db:migrate:production": "cf d1 migrations apply 84d08125-de96-4fd4-844e-f5a5c1c8214c --dir migrations",
    "secrets:preview": "node scripts/put-secrets.ts preview",
    "secrets:production": "node scripts/put-secrets.ts production",
    "prepare": "node scripts/build-client.ts"
  },
  "dependencies": {
    "@be-music/service-auth-client": "workspace:*",
    "@be-music/service-web-theme": "workspace:*",
    "@be-music/shared-utils": "workspace:*",
    "@better-auth/oauth-provider": "1.7.14",
    "@better-auth/passkey": "1.7.14",
    "better-auth": "1.7.14",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "cf": "1.0.0-beta.25",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "vite-plus": "catalog:",
    "wrangler": "^4.155.0"
  }
}
