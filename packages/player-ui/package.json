{
  "name": "@be-music/player-ui",
  "version": "0.4.0",
  "description": "Reusable Lit Web Components for Be-Music player interfaces",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./themes/basecoat": {
      "source": "./src/themes/basecoat.ts",
      "types": "./dist/themes/basecoat.d.ts",
      "default": "./dist/themes/basecoat.js"
    }
  },
  "scripts": {
    "prepare": "node --experimental-strip-types scripts/build-css.ts",
    "build:css": "node --experimental-strip-types scripts/build-css.ts",
    "build": "vp pack",
    "clean": "rimraf dist",
    "bench": "node --conditions=source scripts/bench.ts"
  },
  "dependencies": {
    "@be-music/player-skin-sdk": "workspace:*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "basecoat-css": "^1.0.2",
    "tailwindcss": "^4.3.3"
  }
}
