{
  "name": "@be-music/stringifier",
  "version": "0.3.1",
  "description": "Stringifier from be-music JSON charts to BMS or BMSON",
  "license": "MIT",
  "bin": {
    "bms-stringify": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:bundle": "tsdown",
    "build": "tsdown",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "dev": "node src/cli.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "bench": "node scripts/bench.ts"
  },
  "dependencies": {
    "@be-music/chart": "workspace:*",
    "@be-music/json": "workspace:*",
    "@be-music/parser": "workspace:*",
    "@be-music/utils": "workspace:*"
  }
}
