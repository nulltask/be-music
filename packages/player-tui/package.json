{
  "name": "@be-music/player-tui",
  "version": "0.4.0",
  "description": "Terminal UI and CLI frontend for the be-music player",
  "license": "MIT",
  "bin": {
    "bms-player": "dist/cli.js",
    "bms-playlog": "dist/playlog-cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:bundle": "tsdown",
    "build": "tsdown",
    "build:sea": "node ../../scripts/build-sea.ts --package player",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "dev": "node src/cli.ts",
    "playlog": "node src/playlog-cli.ts",
    "diag:keyboard": "node src/keyboard-diagnostic.ts",
    "diag:gameplay-input": "node src/gameplay-input-diagnostic.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "bench": "node scripts/bench.ts"
  },
  "dependencies": {
    "@be-music/audio-renderer": "workspace:*",
    "@be-music/chart": "workspace:*",
    "@be-music/json": "workspace:*",
    "@be-music/parser": "workspace:*",
    "@be-music/player": "workspace:*",
    "@be-music/utils": "workspace:*",
    "@uwx/libav.js-fat": "6.0.0-nightly.29.f420ff.ffmpeg.6.1.1",
    "alien-signals": "^3.2.1",
    "fast-bmp": "^4.0.1",
    "fast-png": "^8.0.0",
    "jpeg-js": "^0.4.4"
  }
}
