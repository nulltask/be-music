{
  "name": "@be-music/player-web",
  "version": "0.9.0",
  "description": "Vanilla browser PixiJS core for be-music song selection and gameplay",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "source": "./src/host/index.ts",
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./skin": {
      "source": "./src/skin/index.ts",
      "types": "./dist/skin.d.ts",
      "default": "./dist/skin.js"
    },
    "./collection": {
      "source": "./src/collection/index.ts",
      "types": "./dist/collection.d.ts",
      "default": "./dist/collection.js"
    },
    "./audio": {
      "source": "./src/runtime/index.ts",
      "types": "./dist/audio.d.ts",
      "default": "./dist/audio.js"
    },
    "./recording": {
      "source": "./src/recording/index.ts",
      "types": "./dist/recording.d.ts",
      "default": "./dist/recording.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "clean": "rimraf dist",
    "bench": "node --conditions=source scripts/bench.ts"
  },
  "dependencies": {
    "@be-music/audio-renderer": "workspace:*",
    "@be-music/beatoraja-skin": "workspace:*",
    "@be-music/chart": "workspace:*",
    "@be-music/json": "workspace:*",
    "@be-music/lr2-skin": "workspace:*",
    "@be-music/parser": "workspace:*",
    "@be-music/player": "workspace:*",
    "@be-music/scene-model": "workspace:*",
    "@be-music/skin-sdk": "workspace:*",
    "@be-music/utils": "workspace:*",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/core-mt": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "fflate": "^0.8.3",
    "mediabunny": "^1.61.3",
    "mp4-muxer": "^5.2.2",
    "pixi.js": "^8.22.0",
    "signalsmith-stretch": "^1.3.2",
    "ts-ebml": "^3.0.2"
  }
}
