{
  "name": "@be-music/audio-renderer",
  "version": "0.2.3",
  "description": "Renderer for BMS, BMSON, and be-music JSON charts to WAV or AIFF",
  "license": "MIT",
  "bin": {
    "bms-audio-render": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./triggers": {
      "types": "./dist/core/triggers.d.ts",
      "source": "./src/core/triggers.ts",
      "default": "./dist/core/triggers.js"
    }
  },
  "scripts": {
    "build:bundle": "tsdown",
    "build": "tsdown",
    "build:sea": "node --conditions=source ../../scripts/build-sea.ts --package audio-renderer",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "dev": "node --conditions=source src/cli.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "bench": "node --conditions=source scripts/bench.ts"
  },
  "dependencies": {
    "@be-music/chart": "workspace:*",
    "@be-music/json": "workspace:*",
    "@be-music/parser": "workspace:*",
    "@be-music/utils": "workspace:*",
    "@wasm-audio-decoders/ogg-vorbis": "^0.1.20",
    "mpg123-decoder": "^1.0.3",
    "ogg-opus-decoder": "^1.7.3"
  }
}
