{
  "name": "@be-music/player-vue",
  "version": "0.1.0",
  "description": "Vue adapter for the be-music browser PixiJS core",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.declarations.json --declaration --emitDeclarationOnly",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "vue-tsc -p tsconfig.typecheck.json --pretty",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check"
  },
  "dependencies": {
    "@be-music/player-web-core": "workspace:*",
    "vue": "^3.5.32"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "vue-tsc": "^3.2.6"
  }
}
