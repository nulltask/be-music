{
  "name": "@be-music/player-web-core",
  "version": "0.1.0",
  "description": "Browser PixiJS core for be-music song browsing and future gameplay rendering",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "bench": "tsx --tsconfig ../../tsconfig.typecheck.json scripts/bench.ts",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsgo -p tsconfig.typecheck.json --pretty",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check"
  },
  "dependencies": {
    "@be-music/json": "workspace:*",
    "@be-music/parser": "workspace:*",
    "fflate": "^0.8.2",
    "pixi.js": "^8.17.1"
  }
}
