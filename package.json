{
  "name": "be-music",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript workspace for the be-music BMS and bmson toolchain, players, and web services",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vp run -r --cache build",
    "clean": "vp run -r clean && rimraf coverage \"packages/*/node_modules/.vite\"",
    "check": "vp check && node scripts/lint/file-size-budget.ts",
    "check:file-size": "node scripts/lint/file-size-budget.ts",
    "changeset": "changeset",
    "release:status": "changeset status --verbose",
    "release:version": "changeset version",
    "typecheck": "vp check --no-fmt --no-lint",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:regression": "vp test run --project regression",
    "test:e2e": "playwright test -c packages/app-play/e2e/playwright.config.ts",
    "bench": "node --conditions=source scripts/bench/exports.ts",
    "bench:aggregate": "node --conditions=source scripts/bench/aggregate-results.ts",
    "bench:compare": "node --conditions=source scripts/bench/compare-results.ts",
    "player": "pnpm --filter @be-music/player-terminal run dev",
    "replay": "pnpm --filter @be-music/player-terminal run replay",
    "player:web": "pnpm --filter @be-music/app-play run dev",
    "player:diag:keyboard": "pnpm --filter @be-music/player-terminal run diag:keyboard",
    "player:diag:gameplay-input": "pnpm --filter @be-music/player-terminal run diag:gameplay-input",
    "player:sea": "pnpm --filter @be-music/player-terminal run build:sea",
    "audio-renderer:sea": "pnpm --filter @be-music/chart-audio-renderer run build:sea",
    "editor": "pnpm --filter @be-music/chart-editor run dev",
    "audio-render": "pnpm --filter @be-music/chart-audio-renderer run dev",
    "parse": "pnpm --filter @be-music/chart-parser run dev",
    "stringify": "pnpm --filter @be-music/chart-writer run dev",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@be-music/chart-audio-renderer": "workspace:*",
    "@be-music/chart-editor": "workspace:*",
    "@be-music/chart-model": "workspace:*",
    "@be-music/chart-parser": "workspace:*",
    "@be-music/chart-source": "workspace:*",
    "@be-music/chart-writer": "workspace:*",
    "@be-music/player-browser": "workspace:*",
    "@be-music/player-engine": "workspace:*",
    "@be-music/player-node-audio": "workspace:*",
    "@be-music/player-scene-model": "workspace:*",
    "@be-music/player-skin-sdk": "workspace:*",
    "@be-music/player-terminal": "workspace:*",
    "@be-music/shared-utils": "workspace:*",
    "@be-music/skin-beatoraja": "workspace:*",
    "@be-music/skin-lr2": "workspace:*",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "catalog:",
    "fflate": "^0.8.3",
    "rimraf": "^6.0.1",
    "tinybench": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.30.3"
}
