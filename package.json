{
  "name": "be-music",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript monorepo for the be-music BMS/BMSON toolchain",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r --sort --workspace-concurrency=Infinity run build",
    "clean": "pnpm -r run clean && rimraf coverage \"packages/*/node_modules/.vite\"",
    "changeset": "changeset",
    "release:status": "changeset status --verbose",
    "release:version": "changeset version",
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "pnpm -r --parallel run lint",
    "lint:fix": "pnpm -r --parallel run lint:fix",
    "format": "pnpm -r --parallel run format",
    "format:check": "pnpm -r --parallel run format:check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "tsx --tsconfig tsconfig.typecheck.json scripts/bench/exports.ts",
    "bench:aggregate": "tsx --tsconfig tsconfig.typecheck.json scripts/bench/aggregate-results.ts",
    "bench:compare": "tsx --tsconfig tsconfig.typecheck.json scripts/bench/compare-results.ts",
    "player": "pnpm --filter @be-music/player-tui run dev",
    "player:web": "pnpm --filter @be-music/player-web-demo run dev",
    "player:diag:keyboard": "pnpm --filter @be-music/player-tui run diag:keyboard",
    "player:diag:gameplay-input": "pnpm --filter @be-music/player-tui run diag:gameplay-input",
    "player:sea": "pnpm --filter @be-music/player-tui run build:sea",
    "audio-renderer:sea": "pnpm --filter @be-music/audio-renderer run build:sea",
    "editor": "pnpm --filter @be-music/editor run dev",
    "audio-render": "pnpm --filter @be-music/audio-renderer run dev",
    "parse": "pnpm --filter @be-music/parser run dev",
    "stringify": "pnpm --filter @be-music/stringifier run dev"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.73.0",
    "rimraf": "^6.0.1",
    "tinybench": "^6.0.2",
    "tsdown": "^0.22.3",
    "tsx": "^4.23.0",
    "typescript": "7.0.1-rc",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=25"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "typescript": "7.0.1-rc"
      }
    }
  }
}
